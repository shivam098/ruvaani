# Safe default: no real accounts, enquiries or payments are accepted.
DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required when DEMO_MODE=false. Use an Atlas replica set for transactions.
MONGODB_URI=
MONGODB_DB=ruvaani

# Optional legacy test-order reconciliation only. New checkout is disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional public support destination, country code + phone number (digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Used only by npm run admin:create; remove after provisioning.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
