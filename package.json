{
  "name": "ruvaani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:backend": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "catalogues:generate": "tsx scripts/generate-catalogues.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "engines": { "node": ">=22.12.0 <25" },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.10.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@playwright/test": "^1.58.0",
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "mongodb-memory-server": "^10.2.0",
    "typescript": "^5",
    "tsx": "^4"
  }
}
